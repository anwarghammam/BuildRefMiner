<project>
  <modelVersion>4.0.0</modelVersion>

  <GroupId>com.Example</GroupId> <!-- ❌ tag name is not lowercase -->
  <artifactId>My.App</artifactId> <!-- ❌ contains dot -->
  <version>1.0.0</version>

  <!-- Multi-line comment
       explaining the properties section
       should be ignored by BLOC -->
  <properties>
    <Java_Version>17</Java_Version> <!-- ❌ uses underscore and uppercase -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version></version> <!-- ❌ empty value -->
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId> <!-- ❌ duplicate -->
      </plugin>
    </plugins>
  </build>
    <profiles>
    <profile>
      <id>dev-profile</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>test</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

