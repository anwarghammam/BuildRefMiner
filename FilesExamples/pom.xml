<project>
  <modelVersion>4.0.0</modelVersion>

  <GroupId>com.Example</GroupId> <!-- ❌ tag name is not lowercase -->
  <artifactId>My.App</artifactId> <!-- ❌ contains dot -->
  <version>1.0.0</version>

  <!-- Multi-line comment
       explaining the properties section
       should be ignored by BLOC -->
  <properties>
    <Java_Version>17</Java_Version> <!-- ❌ uses underscore and uppercase -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version></version> <!-- ❌ empty value -->
    </dependency>
  </dependencies>

  <!-- ===== Added duplicate fragments for Clone Density demo ===== -->
  <profiles>
    <profile>
      <id>cloneProfileA</id>

      <!-- identical 5-line clone chunk starts here -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <demo.clone>YES</demo.clone>
      </properties>
      <!-- identical 5-line clone chunk ends here -->

      <build>
        <finalName>clone-demo</finalName>
      </build>
    </profile>

    <profile>
      <id>cloneProfileB</id>

      <!-- identical 5-line clone chunk starts here -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <demo.clone>YES</demo.clone>
      </properties>
      <!-- identical 5-line clone chunk ends here -->

      <build>
        <finalName>clone-demo</finalName>
      </build>
