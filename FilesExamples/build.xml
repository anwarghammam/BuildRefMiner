<project name="ExampleProject" default="compile" basedir=".">
    
    <!-- Initialize properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>

    <!--
        This is a multi-line XML comment
        It should not be counted by BLOC
    -->
    <target name="init">
        <mkdir dir="${build.dir}"/>
    </target>

    <target name="compile" depends="init" if="src.dir">
        <javac srcdir="${src.dir}" destdir="${build.dir}"/>
    </target>

    <!-- Clean target -->
    <target name="clean" unless="skip.clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="run">
        <condition property="can.run">
            <available file="${build.dir}/Main.class"/>
        </condition>
        <echo message="Ready to run."/>
    </target>

    <!-- ===== Added duplicate fragments for Clone Density demo ===== -->
    <target name="dupA">
        <echo message="CLONE_START"/>
        <mkdir dir="${build.dir}/tmp"/>
        <echo message="LINE_1"/>
        <echo message="LINE_2"/>
        <echo message="CLONE_END"/>
    </target>

    <target name="dupB">
        <echo message="CLONE_START"/>
        <mkdir dir="${build.dir}/tmp"/>
        <echo message="LINE_1"/>
        <echo message="LINE_2"/>
        <echo message="CLONE_END"/>
    </target>
    <!-- ============================================================ -->

</project>