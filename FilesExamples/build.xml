<project name="ExampleProject" default="compile" basedir=".">

    <property name="src.dir" value="/Users/thanujaavr/project/src"/>
    <property name="build.dir" value="build"/>

    <!-- TODO: remove hardcoded path and improve target dependencies -->

    <target name="init">
        <mkdir dir="${build.dir}"/>
    </target>

    <target name="compile" depends="init,clean,run,dupA,dupB">
        <javac srcdir="${src.dir}" destdir="${build.dir}"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="run">
        <condition property="can.run">
            <available file="${build.dir}/Main.class"/>
        </condition>
        <echo message="Ready to run."/>
    </target>

    <target name="dupA">
        <echo message="CLONE_START"/>
        <mkdir dir="${build.dir}/tmp"/>
        <echo message="LINE_1"/>
        <echo message="LINE_2"/>
        <echo message="CLONE_END"/>
    </target>

    <target name="dupB">
        <echo message="CLONE_START"/>
        <mkdir dir="${build.dir}/tmp"/>
        <echo message="LINE_1"/>
        <echo message="LINE_2"/>
        <echo message="CLONE_END"/>
    </target>

    <target name="execTarget">
        <exec executable="rm" failonerror="false">
            <arg value="-rf"/>
            <arg value="/tmp/build-temp"/>
        </exec>
    </target>

    <target name="dupA">
        <echo message="Duplicate target name for smell detection"/>
    </target>

</project>